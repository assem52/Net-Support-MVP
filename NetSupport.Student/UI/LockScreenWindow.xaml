<Window x:Class="NetSupport.Student.UI.LockScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Locked" 
        WindowStyle="None" 
        WindowState="Maximized" 
        Topmost="True" 
        Background="#D9202020" 
        ShowInTaskbar="False">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Screen Locked by Instructor" 
                       Foreground="White" 
                       FontSize="48" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>
                       
            <Button Content="Emergency Unlock" 
                    Width="150" Height="40" 
                    Background="#440000" 
                    Foreground="White" 
                    BorderThickness="1" 
                    BorderBrush="#FF5555"
                    Cursor="Hand"
                    Click="EmergencyUnlock_Click"/>
        </StackPanel>
    </Grid>
</Window>
