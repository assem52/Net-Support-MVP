<Window x:Class="NetSupport.Designer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSupport MVP - MCQ Designer" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ExportBtn" Content="Export to CSV" Width="120" Height="30" Background="LightBlue" Click="ExportBtn_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Label x:Name="LblLanguage" Content="Language:" VerticalAlignment="Center"/>
                <ComboBox x:Name="LanguageToggle" Width="80" SelectionChanged="LanguageToggle_SelectionChanged" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="English" IsSelected="True" Tag="en"/>
                    <ComboBoxItem Content="العربية" Tag="ar"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Form Panel -->
            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <TextBlock x:Name="LblAddTitle" Text="Add New Question" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                
                <Label x:Name="LblQuestion" Content="Question Text:"/>
                <TextBox x:Name="TxtQuestion" Height="60" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <Label x:Name="LblOptions" Content="Options:" FontWeight="SemiBold"/>
                
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <RadioButton x:Name="RbA" Content="A" GroupName="Correct" IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtOptionA" Grid.Column="1" Height="25"/>
                </Grid>
                
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <RadioButton x:Name="RbB" Content="B" GroupName="Correct" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtOptionB" Grid.Column="1" Height="25"/>
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <RadioButton x:Name="RbC" Content="C" GroupName="Correct" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtOptionC" Grid.Column="1" Height="25"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <RadioButton x:Name="RbD" Content="D" GroupName="Correct" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtOptionD" Grid.Column="1" Height="25"/>
                </Grid>

                <Button x:Name="AddQuestionBtn" Content="Add to Exam" Height="35" Background="LightGreen" Click="AddQuestionBtn_Click"/>
            </StackPanel>

            <!-- Right List Panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock x:Name="LblListTitle" Text="Questions in Exam:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                
                <DataGrid x:Name="QuestionsGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,10"/>
                
                <Button x:Name="DeleteBtn" Grid.Row="2" Content="Delete Selected" Height="30" Width="150" HorizontalAlignment="Right" Background="LightCoral" Click="DeleteQuestionBtn_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
