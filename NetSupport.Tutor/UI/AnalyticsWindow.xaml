<Window x:Class="NetSupport.Tutor.UI.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Analytics Dashboard" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9" FontFamily="Segoe UI">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="15" Opacity="0.1" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="10,10,10,20">
                <TextBlock Text="Class Performance Analytics" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Real-time data from all connected students" FontSize="14" Foreground="#64748B"/>
            </StackPanel>

            <!-- Summary Row -->
            <UniformGrid Grid.Row="1" Columns="4">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Class Average" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtAvg" Text="0%" FontSize="32" FontWeight="ExtraBold" Foreground="#4F46E5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Submissions" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtSubmissions" Text="0" FontSize="32" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Pass Rate" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtPassRate" Text="0%" FontSize="32" FontWeight="ExtraBold" Foreground="#10B981" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Top Score" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtMax" Text="0%" FontSize="32" FontWeight="ExtraBold" Foreground="#F59E0B" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Charts Section -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Score Distribution -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Score Distribution" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>
                        <ItemsControl x:Name="ScoreDistributionChart">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>
                                        <Border Grid.Column="1" Background="#E2E8F0" Height="20" CornerRadius="10" Margin="10,0">
                                            <Border Background="{Binding Color}" CornerRadius="10" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Question Analytics -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Question Success Rates" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>
                        
                        <!-- Hardest Question Alert -->
                        <Border DockPanel.Dock="Top" x:Name="HardestAlert" Background="#FEF2F2" Padding="15" CornerRadius="8" Margin="0,0,0,20" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⚠️ Hardest Question Alert" FontWeight="Bold" Foreground="#991B1B"/>
                                <TextBlock x:Name="TxtHardestQ" Text="Question Text..." FontSize="13" Foreground="#B91C1C" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="QuestionChart">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#334155" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#F1F5F9" Height="12" CornerRadius="6">
                                                <Border Background="{Binding Color}" CornerRadius="6" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding RateString}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Color}"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
