<Window x:Class="NetSupport.Tutor.UI.TestingConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Testing Console" Height="350" Width="450" WindowStartupLocation="CenterOwner"
        Background="#F4F7FE" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern Rounded Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#4F46E5" BlurRadius="10" Opacity="0.3" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4338CA" TargetName="border"/>
                                <Setter Property="Effect" TargetName="border">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#4338CA" BlurRadius="15" Opacity="0.5" ShadowDepth="3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3730A3" TargetName="border"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#E0E7FF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#94A3B8" BlurRadius="5" Opacity="0.1" ShadowDepth="1"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC" TargetName="border"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" Margin="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#94A3B8" BlurRadius="20" Opacity="0.1" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Exam Assignment Configuration" FontWeight="Bold" FontSize="18" Foreground="#1E293B" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnBrowse" Content="Browse CSV..." Width="120" Style="{StaticResource SecondaryButton}" Click="BtnBrowse_Click"/>
                    <TextBlock x:Name="TxtFileName" Text="No file selected" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="#64748B" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,25" HorizontalAlignment="Center">
                <TextBlock Text="Duration (minutes):" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#334155" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtDuration" Width="60" Height="30" Text="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>
            </StackPanel>

            <Button x:Name="BtnPush" Grid.Row="3" Content="Push Exam to Selected Student" Height="45" VerticalAlignment="Bottom" Style="{StaticResource ModernButton}" Background="#10B981" Click="BtnPush_Click"/>
        </Grid>
    </Border>
</Window>
