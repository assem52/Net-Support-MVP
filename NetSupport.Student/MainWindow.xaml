<Window x:Class="NetSupport.Student.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetSupport.Student"
        mc:Ignorable="d"
        Title="NetSupport Student" 
        Height="520" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Pulsing animation for the status indicator -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.2" Duration="0:0:1"
                             AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Dark gradient background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F1117" Offset="0"/>
                <GradientStop Color="#1A1D2E" Offset="0.5"/>
                <GradientStop Color="#0F1117" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Subtle grid pattern overlay -->
        <Rectangle Opacity="0.03">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,30,30" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="White">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,30"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="600">

            <!-- Shield / Lock Icon (geometric) -->
            <Viewbox Width="80" Height="80" Margin="0,0,0,28">
                <Canvas Width="100" Height="100">
                    <!-- Shield body -->
                    <Path Fill="#3B4FC8" Opacity="0.9">
                        <Path.Data>
                            <PathGeometry Figures="M50,5 L90,22 L90,52 Q90,80 50,95 Q10,80 10,52 L10,22 Z"/>
                        </Path.Data>
                    </Path>
                    <!-- Lock body -->
                    <Rectangle Canvas.Left="35" Canvas.Top="48" Width="30" Height="22" RadiusX="4" RadiusY="4" Fill="White" Opacity="0.9"/>
                    <!-- Lock shackle -->
                    <Path Stroke="White" StrokeThickness="5" Fill="Transparent" Opacity="0.9">
                        <Path.Data>
                            <PathGeometry Figures="M38,48 L38,38 Q38,26 50,26 Q62,26 62,38 L62,48"/>
                        </Path.Data>
                    </Path>
                    <!-- Keyhole -->
                    <Ellipse Canvas.Left="45" Canvas.Top="54" Width="10" Height="10" Fill="#3B4FC8"/>
                    <Rectangle Canvas.Left="48" Canvas.Top="62" Width="4" Height="5" Fill="#3B4FC8"/>
                </Canvas>
            </Viewbox>

            <!-- App Name -->
            <TextBlock Text="NetSupport" 
                       Foreground="#6C75E1"
                       FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>

            <!-- Main Status Message -->
            <TextBlock Text="Waiting for Instructor" 
                       Foreground="White"
                       FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <!-- Sub message -->
            <TextBlock Text="Your workstation has been registered on the network.&#10;The instructor will begin the session shortly."
                       Foreground="#8892B0"
                       FontSize="14"
                       TextAlignment="Center"
                       LineHeight="22"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Animated Status Row -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse x:Name="PulseDot" Width="10" Height="10" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="StatusText"
                           Text="Connected and broadcasting presence..."
                           Foreground="#4ADE80"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Divider -->
            <Rectangle Height="1" Margin="80,32,80,32" Opacity="0.12">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="White" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Info Row: Machine name -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="WORKSTATION" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="MachineNameText" Text="..." Foreground="#8892B0" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
