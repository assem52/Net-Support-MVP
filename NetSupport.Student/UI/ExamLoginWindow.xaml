<Window x:Class="NetSupport.Student.UI.ExamLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exam Login" 
        WindowStyle="None" 
        WindowState="Maximized" 
        Topmost="True" 
        Background="White" 
        ShowInTaskbar="False">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Welcome to the Exam" FontSize="36" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <TextBlock Text="Please enter your full name to begin:" FontSize="18" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <TextBox x:Name="TxtName" Width="300" Height="40" FontSize="18" Margin="0,0,0,20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <Button x:Name="BtnSubmit" Content="I am Ready" Width="150" Height="40" FontSize="18" Click="BtnSubmit_Click"/>
            
            <TextBlock x:Name="TxtWaiting" Text="Waiting for Instructor to start the exam..." FontSize="20" Foreground="Green" HorizontalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
